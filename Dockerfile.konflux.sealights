# Build arguments
ARG SOURCE_CODE=.

FROM registry.access.redhat.com/ubi9/nodejs-22@sha256:bb046ef111dd20f890fe9879a37df8e829ed661177fae2339ba7eeb495f46c60 AS builder

## Build args to be used at this step
ARG SOURCE_CODE

WORKDIR /usr/src/app

## Copying in source code
COPY --chown=default:root ${SOURCE_CODE} /usr/src/app

# Change file ownership to the assemble user
USER default

# Install pnpm and workspace dependencies. Lifecycle scripts are restricted by
# pnpm-workspace.yaml allowBuilds; Cypress binary installation is disabled explicitly.
RUN npm install -g pnpm@11.22.0
RUN CYPRESS_INSTALL_BINARY=0 pnpm install --frozen-lockfile --offline # NOSONAR

ENV TURBO_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS=--max-old-space-size=8192

# Set Red Hat Openshift AI logo and links
ENV ODH_LOGO=../images/rhoai-logo.svg
ENV ODH_LOGO_DARK=../images/rhoai-logo-dark-theme.svg
ENV ODH_PRODUCT_NAME="Red Hat OpenShift AI"
ENV ODH_FAVICON="rhoai-favicon.svg"
ENV DOC_LINK="https://docs.redhat.com/en/documentation/red_hat_openshift_ai/"
ENV SUPPORT_LINK="https://access.redhat.com/support/cases/#/case/new/open-case?caseCreate=true"
ENV COMMUNITY_LINK=""

RUN pnpm run build

## BEGIN SEALIGHTS
ARG SEALIGHTS_BUILD_NAME=
ARG SEALIGHTS_BSID=
ARG COMMIT=

# Keep Sealights isolated from the pnpm workspace and reuse this pinned installation
# in the runtime image.
USER root
RUN npm install --prefix /opt/sealights slnodejs@6.1.1067 # NOSONAR

RUN --mount=type=secret,id=sealights-credentials/token \
    SEALIGHTS_TOKEN="$(cat /run/secrets/sealights-credentials/token)" && \
    /opt/sealights/node_modules/.bin/slnodejs scan --token "${SEALIGHTS_TOKEN}" --buildsessionid "${SEALIGHTS_BSID}" --scm none --workspacepath "./frontend/public" --es6Modules --scmProvider github --scmBaseUrl https://github.com/red-hat-data-services/odh-dashboard/ --uniqueModuleId frontend

RUN --mount=type=secret,id=sealights-credentials/token \
    SEALIGHTS_TOKEN="$(cat /run/secrets/sealights-credentials/token)" && \
    /opt/sealights/node_modules/.bin/slnodejs scan --token "${SEALIGHTS_TOKEN}" --buildsessionid "${SEALIGHTS_BSID}" --scm none --workspacepath "./backend/dist" --es6Modules --scmProvider github --scmBaseUrl https://github.com/red-hat-data-services/odh-dashboard/ --uniqueModuleId backend

RUN --mount=type=secret,id=sealights-credentials/token \
    SEALIGHTS_TOKEN="$(cat /run/secrets/sealights-credentials/token)" && \
    /opt/sealights/node_modules/.bin/slnodejs buildend --token "${SEALIGHTS_TOKEN}" --buildsessionid "${SEALIGHTS_BSID}" --ok

RUN --mount=type=secret,id=sealights-credentials/token \
    SEALIGHTS_TOKEN="$(cat /run/secrets/sealights-credentials/token)" && \
    /opt/sealights/node_modules/.bin/slnodejs instrument --token "${SEALIGHTS_TOKEN}" --buildsessionid "${SEALIGHTS_BSID}" --workspacepath "./frontend/public" --outputpath sl_build --labid sl_LabId_ReplaceMe
RUN rm -rf ./frontend/public
RUN mv -v sl_build ./frontend/public
## END SEALIGHTS

FROM registry.access.redhat.com/ubi9/nodejs-22@sha256:bb046ef111dd20f890fe9879a37df8e829ed661177fae2339ba7eeb495f46c60 AS runtime

WORKDIR /usr/src/app

RUN mkdir /usr/src/app/logs && chmod 775 /usr/src/app/logs

USER 1001:0

COPY --chown=1001:0 --from=builder /usr/src/app/frontend/public /usr/src/app/frontend/public
COPY --chown=1001:0 --from=builder /usr/src/app/backend/dist /usr/src/app/backend/dist
COPY --chown=1001:0 --from=builder /usr/src/app/.env /usr/src/app/.env
COPY --chown=1001:0 --from=builder /usr/src/app/data /usr/src/app/data
COPY --chown=1001:0 --from=builder /opt/sealights /opt/sealights

WORKDIR /usr/src/app/backend

# BEGIN SEALIGHTS
ENV NODE_OPTIONS="--require /opt/sealights/node_modules/slnodejs/lib/preload.js"

ARG SEALIGHTS_BSID=
ENV SL_BUILD_SESSION_ID=$SEALIGHTS_BSID
ENV SL_TOKENFILE=/usr/src/app/backend/sltoken.txt
ENV SL_LAB_ID=ods-qe-psi-02

USER root
RUN --mount=type=secret,id=sealights-credentials/token cp /run/secrets/sealights-credentials/token $SL_TOKENFILE
RUN chmod +r ${SL_TOKENFILE}
# RUN find /usr/src/app/frontend/public -type f -name "*.js" -exec sed -i 's/sl_LabId_ReplaceMe/ods-qe-psi-02/g' {} +
USER 1001:0
# END SEALIGHTS

ENV NODE_ENV=production
ENV IP=127.0.0.1
CMD ["node", "./dist/server.js"]

LABEL com.redhat.component="odh-dashboard-container" \
      name="managed-open-data-hub/odh-dashboard-rhel8" \
      description="odh-dashboard" \
      summary="odh-dashboard" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-dashboard" \
      io.k8s.description="odh-dashboard" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"
